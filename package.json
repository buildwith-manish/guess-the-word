{
  "name": "guess-the-word",
  "version": "1.0.0",
  "private": true,
  "description": "Guess the Word by Emoji - 50 question quiz, built with Remotion + GSAP easing math (Pattern 1: no GSAP timelines).",
  "scripts": {
    "postinstall": "node scripts/build-questions.js",
    "dev": "remotion studio",
    "timeline": "node scripts/timeline.js",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/voiceover-scan.js && node scripts/render-batches.js --lane",
    "render:batches": "node scripts/voiceover-scan.js && node scripts/render-batches.js",
    "render:lanes": "node scripts/voiceover-scan.js && node scripts/render-batches.js --size 1800",
    "still": "remotion still GuessTheWord out/still.png --frame=1400",
    "data": "node scripts/build-questions.js",
    "sounds": "node scripts/generate-audio.js",
    "images": "node scripts/fetch-images.js",
    "images:resize": "node scripts/resize-images.js",
    "images:refetch": "node scripts/refetch-broken.js",
    "images:hd": "node scripts/fetch-images.js --force && node scripts/resize-images.js && node scripts/refetch-broken.js",
    "images:all": "node scripts/fetch-images.js && node scripts/resize-images.js && node scripts/refetch-broken.js",
    "voiceover": "node scripts/voiceover-scan.js",
    "voiceover:script": "node scripts/voiceover-script.js"
  },
  "dependencies": {
    "@react-three/fiber": "^9.3.0",
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/motion-blur": "^4.0.539",
    "@remotion/three": "4.0.539",
    "gsap": "^3.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.539",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.6.0"
  }
}
